<div data-controller="wake-lock" data-action="visibilitychange@document->wake-lock#acquire"></div>

<% if @song %>
  <header class="song-head">
    <div>
      <h1><%= @song.title %></h1>
      <p class="artist"><%= @song.artist %></p>
    </div>
    <% if @room.room_key %>
      <p class="keybox" id="room-key"><span class="key-label">Room key</span> <span class="key"><%= @room.room_key %></span></p>
    <% end %>
  </header>
  <%= render "rooms/host_controls", room: @room if authenticated? %>
  <%= render "songs/notes", song: @song %>
  <%= render "songs/sheet", song: @song, key: @room.room_key %>
<% else %>
  <section class="empty-room">
    <%= image_tag "chalk-guitar.webp", alt: "", class: "chalk-sketch", width: 556, height: 720 %>
    <h1>Nothing playing yet</h1>
    <% if authenticated? %>
      <p class="muted">Pick the first song and everyone's phone follows.</p>
      <%= link_to "Pick a song", songs_path, class: "button primary" %>
    <% else %>
      <p class="muted">Hang on. When the host picks a song, it shows up here.</p>
    <% end %>
  </section>
<% end %>

<p class="install-hint" data-controller="install-hint" hidden>
  Add Jambook to your home screen: Share, then Add to Home Screen.
  <button type="button" data-action="install-hint#dismiss">OK</button>
</p>
