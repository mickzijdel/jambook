<%# locals: (song:, key:, key_label:, room_controls: false, actions: nil) %>
<div id="sheet" class="song-view"
     data-controller="chord-sheet"
     data-action="turbo:morph@window->chord-sheet#render resize@window->chord-sheet#fitTabs"
     data-chord-sheet-sheet-value="<%= song.sheet %>"
     data-chord-sheet-format-value="<%= song.sheet_format %>"
     data-chord-sheet-written-key-value="<%= song.written_key %>"
     data-chord-sheet-written-capo-value="<%= song.written_capo %>"
     data-chord-sheet-key-value="<%= key %>"
     data-chord-sheet-song-id-value="<%= song.id %>">
  <header class="song-head">
    <div class="song-id">
      <h1><%= song.title %></h1>
      <p class="artist"><%= song.artist %></p>
    </div>
    <% if key.present? %>
      <div class="keybox" id="room-key">
        <span class="key-label"><%= key_label %></span>
        <div class="stepper">
          <%= button_to "−", room_key_path(delta: -1), method: :patch, class: "step", form_class: "step-form", "aria-label": "Key down a semitone" if room_controls %>
          <span class="key"><%= key %></span>
          <%= button_to "+", room_key_path(delta: 1), method: :patch, class: "step", form_class: "step-form", "aria-label": "Key up a semitone" if room_controls %>
        </div>
      </div>
    <% end %>
    <div class="capo-strip">
      <span class="capo-label" id="capo-label-<%= song.id %>">Capo</span>
      <button type="button" class="step" data-action="chord-sheet#capoDown" aria-label="Capo down one fret">−</button>
      <output class="capo-value" data-chord-sheet-target="capo" aria-labelledby="capo-label-<%= song.id %>"><%= song.written_capo %></output>
      <button type="button" class="step" data-action="chord-sheet#capoUp" aria-label="Capo up one fret">+</button>
      <span class="sheet-status" data-chord-sheet-target="status" aria-live="polite"></span>
    </div>
  </header>

  <% if actions.present? %>
    <div class="song-actions row-of-buttons"><%= actions %></div>
  <% end %>
  <%= render "songs/notes", song: song %>
  <div id="sheet-output" class="sheet-output" data-chord-sheet-target="output" data-turbo-permanent></div>
</div>
