<% if @song %>
  <h1><%= @song.title %> – <%= @song.artist %></h1>
  <p id="room-key">Room key <%= @room.room_key %></p>
  <p id="notes"><%= @song.notes %></p>
  <%= render "rooms/host_controls", room: @room if authenticated? %>
  <%= render "songs/sheet", song: @song, key: @room.room_key, label: "Room key" %>
<% else %>
  <h1>Nothing playing yet</h1>
  <%= tag.p("Pick a song") if authenticated? %>
<% end %>
